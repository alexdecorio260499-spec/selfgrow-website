# ==============================================================================
# SelfGrow Website — Environment Configuration
# ==============================================================================
# The website runs with built-in development logging fallback when email keys
# are omitted. Fill in the keys below for live transactional email delivery.

# Resend API Key (Optional for production email dispatch)
# Get your API key at https://resend.com
RESEND_API_KEY=

# Verified sender email address (Defaults to onboarding@resend.dev in dev)
# In production, use your authenticated domain e.g. notifications@selfgrow.green
EMAIL_FROM="SelfGrow <onboarding@resend.dev>"

# Destination email for pre-order reservations and commercial enquiries
EMAIL_TO="contact@selfgrow.green"

# Public site URL (for canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL="https://selfgrow.green"
